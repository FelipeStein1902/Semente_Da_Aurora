MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 508457305}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13be05bc5020cdd4cb79aeb740130c17, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textoFala: {fileID: 1489409247}
  falas:
  - "Ysolde: \"Bran, a \xC1rvore-M\xE3e se foi. Tudo o que restou dela est\xE1 nas
    suas m\xE3os. Esta semente ainda guarda a vida de Verd\xE1lia.\""
  - "Ysolde: \"Suba, meu jovem. Suba at\xE9 a Forja do Bar\xE3o, onde tudo come\xE7ou,
    e plante a semente l\xE1. Por onde voc\xEA passar, a terra vai se lembrar de
    como era viver.\""
  - "Ysolde: \"Mas cuidado: se cair, a semente volta para o lugar onde nasceu, e
    voc\xEA ter\xE1 de recome\xE7ar do vale.\""
